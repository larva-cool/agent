{
    "name": "larva/agent",
    "description": "Desktop/mobile user agent parser with support for Laravel, based on Mobiledetect",
    "keywords": ["laravel", "useragent", "agent", "user agent", "browser", "platform", "mobile", "desktop"],
    "homepage": "https://github.com/larva-cool/agent",
    "license" : "MIT",
    "authors": [
        {
            "name": "Larva",
            "homepage": "https://www.larva.com.cn"
        }
    ],
    "require": {
        "php": ">=8.2",
        "mobiledetect/mobiledetectlib": "^4.11",
        "jaybizzle/crawler-detect": "^1.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Larva\\Agent\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Larva\\Agent\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "4.0-dev"
        },
        "laravel": {
            "providers": [
                "Larva\\Agent\\AgentServiceProvider"
            ],
            "aliases": {
                "Agent": "Larva\\Agent\\Facades\\Agent"
            }
        }
    },
    "suggest": {
        "illuminate/support": "Required for laravel service providers"
    }
}
